{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.aidoctor.dev/contracts/1.1.0/knowledge-release-ref.schema.json",
  "title":"KnowledgeReleaseRef",
  "description":"Reference to a knowledge release. It does not implement a release registry or approve sources.",
  "type":"object","additionalProperties":false,
  "required":["contract_version","knowledge_release_id","source_registry_version","released_at","status","source_refs","checksum_manifest_ref"],
  "properties":{
    "contract_version":{"const":"1.1.0"},
    "knowledge_release_id":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"},
    "source_registry_version":{"$ref":"contract-envelope.schema.json#/$defs/semanticVersion"},
    "released_at":{"$ref":"contract-envelope.schema.json#/$defs/timestamp"},
    "status":{"enum":["DRAFT","ACTIVE","SUPERSEDED","WITHDRAWN"]},
    "source_refs":{"type":"array","minItems":1,"maxItems":512,"uniqueItems":true,"items":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"}},
    "checksum_manifest_ref":{"type":"string","minLength":1,"maxLength":500,"pattern":"^(urn:|artifact://)[A-Za-z0-9._:/-]+$"},
    "withdrawn_at":{"$ref":"contract-envelope.schema.json#/$defs/timestamp"},
    "superseded_by":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"}
  },
  "allOf":[
    {"if":{"properties":{"status":{"enum":["DRAFT","ACTIVE"]}}},"then":{"not":{"anyOf":[{"required":["withdrawn_at"]},{"required":["superseded_by"]}]}}},
    {"if":{"properties":{"status":{"const":"WITHDRAWN"}}},"then":{"required":["withdrawn_at"],"not":{"required":["superseded_by"]}}},
    {"if":{"properties":{"status":{"const":"SUPERSEDED"}}},"then":{"required":["superseded_by"],"not":{"required":["withdrawn_at"]}}}
  ]
}
