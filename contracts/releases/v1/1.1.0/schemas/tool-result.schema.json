{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.aidoctor.dev/contracts/1.1.0/tool-result.schema.json",
  "title":"ToolResult",
  "description":"Tool execution result. Suggested patches remain proposals and are never represented as committed state.",
  "type":"object","additionalProperties":false,
  "required":["contract_version","envelope","tool_name","tool_version","invocation_id","status","reason_code","retryable","output","suggested_patches","evidence_refs","errors","started_at","completed_at"],
  "properties":{
    "contract_version":{"const":"1.1.0"},
    "envelope":{"allOf":[{"$ref":"contract-envelope.schema.json"},{"properties":{"contract_name":{"const":"ToolResult"}}}]},
    "tool_name":{"type":"string","minLength":1,"maxLength":80,"pattern":"^[a-z][a-z0-9-]*$"},
    "tool_version":{"$ref":"contract-envelope.schema.json#/$defs/semanticVersion"},
    "invocation_id":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"},
    "status":{"enum":["SUCCEEDED","NO_RESULT","RETRYABLE_FAILURE","NON_RETRYABLE_FAILURE","TIMED_OUT","POLICY_BLOCKED"]},
    "reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$","maxLength":64},
    "retryable":{"type":"boolean"},
    "output":{"type":"array","maxItems":64,"items":{"$ref":"tool-context.schema.json#/$defs/namedValue"}},
    "suggested_patches":{"type":"array","maxItems":64,"items":{"$ref":"state-patch.schema.json"}},
    "evidence_refs":{"type":"array","uniqueItems":true,"maxItems":64,"items":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"}},
    "errors":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/error"}},
    "started_at":{"$ref":"contract-envelope.schema.json#/$defs/timestamp"},
    "completed_at":{"$ref":"contract-envelope.schema.json#/$defs/timestamp"}
  },
  "$defs":{"error":{"type":"object","additionalProperties":false,"required":["code","category","message","retryable"],"properties":{"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"},"category":{"enum":["VALIDATION","DEPENDENCY","TIMEOUT","AUTHORIZATION","CONFLICT","POLICY","INTERNAL"]},"message":{"type":"string","minLength":1,"maxLength":1000},"retryable":{"type":"boolean"}}}},
  "allOf":[
    {"if":{"properties":{"status":{"const":"SUCCEEDED"}}},"then":{"properties":{"errors":{"maxItems":0},"retryable":{"const":false}}}},
    {"if":{"properties":{"status":{"const":"NO_RESULT"}}},"then":{"properties":{"output":{"maxItems":0},"suggested_patches":{"maxItems":0},"errors":{"maxItems":0},"retryable":{"const":false}}}},
    {"if":{"properties":{"status":{"const":"RETRYABLE_FAILURE"}}},"then":{"properties":{"output":{"maxItems":0},"suggested_patches":{"maxItems":0},"errors":{"minItems":1},"retryable":{"const":true}}}},
    {"if":{"properties":{"status":{"const":"NON_RETRYABLE_FAILURE"}}},"then":{"properties":{"output":{"maxItems":0},"suggested_patches":{"maxItems":0},"errors":{"minItems":1},"retryable":{"const":false}}}},
    {"if":{"properties":{"status":{"const":"TIMED_OUT"}}},"then":{"properties":{"output":{"maxItems":0},"suggested_patches":{"maxItems":0},"errors":{"minItems":1},"retryable":{"const":true}}}},
    {"if":{"properties":{"status":{"const":"POLICY_BLOCKED"}}},"then":{"properties":{"output":{"maxItems":0},"suggested_patches":{"maxItems":0},"errors":{"minItems":1,"contains":{"type":"object","properties":{"category":{"const":"POLICY"}},"required":["category"]}},"retryable":{"const":false}}}}
  ]
}
