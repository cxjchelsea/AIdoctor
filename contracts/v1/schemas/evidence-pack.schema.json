{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.aidoctor.dev/contracts/1.0.0/evidence-pack.schema.json",
  "title":"EvidencePack",
  "description":"Claim-level evidence and citation transport; it does not implement RAG or assert clinical validity.",
  "type":"object","additionalProperties":false,
  "required":["contract_version","evidence_pack_id","knowledge_release_id","created_at","claims","sources","conflicts","limitations"],
  "properties":{
    "contract_version":{"const":"1.0.0"},
    "evidence_pack_id":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"},
    "knowledge_release_id":{"oneOf":[{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"},{"type":"null"}]},
    "created_at":{"$ref":"contract-envelope.schema.json#/$defs/timestamp"},
    "claims":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/claim"}},
    "sources":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/sourceSpan"}},
    "conflicts":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["conflict_id","claim_refs","source_refs","summary"],"properties":{"conflict_id":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"},"claim_refs":{"type":"array","minItems":2,"maxItems":16,"uniqueItems":true,"items":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"}},"source_refs":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"}},"summary":{"type":"string","minLength":1,"maxLength":1000}}}},
    "limitations":{"type":"array","maxItems":64,"items":{"type":"string","minLength":1,"maxLength":1000}}
  },
  "$defs":{
    "claim":{"type":"object","additionalProperties":false,"required":["claim_id","text","claim_type","support_status","citation_refs","applicability","limitations"],"properties":{"claim_id":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"},"text":{"type":"string","minLength":1,"maxLength":2000},"claim_type":{"enum":["SAFETY_RULE","MEDICAL_EVIDENCE","CLINICIAN_DECISION","PATIENT_FACT"]},"support_status":{"enum":["SUPPORTED","PARTIALLY_SUPPORTED","CONFLICTING","INSUFFICIENT_EVIDENCE","NOT_REQUIRED"]},"citation_refs":{"type":"array","uniqueItems":true,"maxItems":32,"items":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"}},"applicability":{"enum":["GENERAL","PATIENT_SPECIFIC","NOT_APPLICABLE","UNKNOWN"]},"limitations":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":1000}}},"allOf":[{"if":{"properties":{"claim_type":{"const":"MEDICAL_EVIDENCE"},"support_status":{"not":{"const":"INSUFFICIENT_EVIDENCE"}}},"required":["claim_type","support_status"]},"then":{"properties":{"citation_refs":{"minItems":1}}}}]},
    "sourceSpan":{"type":"object","additionalProperties":false,"required":["source_id","source_type","title","publisher","release_or_version","jurisdiction","valid_from","valid_to","locator","span","license","retrieved_at"],"properties":{"source_id":{"$ref":"contract-envelope.schema.json#/$defs/opaqueIdentifier"},"source_type":{"enum":["GUIDELINE","KNOWLEDGE_GRAPH","RULE","REFERENCE_TABLE","CLINICIAN_RECORD","PATIENT_RECORD","RESEARCH"]},"title":{"type":"string","minLength":1,"maxLength":300},"publisher":{"type":["string","null"],"maxLength":300},"release_or_version":{"type":["string","null"],"maxLength":100},"jurisdiction":{"type":["string","null"],"maxLength":100,"description":"Null until an authorized policy supplies jurisdiction."},"valid_from":{"oneOf":[{"$ref":"contract-envelope.schema.json#/$defs/timestamp"},{"type":"null"}]},"valid_to":{"oneOf":[{"$ref":"contract-envelope.schema.json#/$defs/timestamp"},{"type":"null"}]},"locator":{"type":"string","minLength":1,"maxLength":500},"span":{"type":"string","minLength":1,"maxLength":1000},"license":{"type":["string","null"],"maxLength":200,"description":"Null means license review is unresolved, not approved."},"retrieved_at":{"$ref":"contract-envelope.schema.json#/$defs/timestamp"}}}
  }
}
