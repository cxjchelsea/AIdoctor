{
  "dashboard": {
    "title": "系统资源监控",
    "tags": ["system", "resources"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "CPU使用率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU使用率",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "使用率 (%)", "max": 100, "min": 0},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 2,
        "title": "内存使用",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "内存使用率",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "使用率 (%)", "max": 100, "min": 0},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 3,
        "title": "内存使用量 (GB)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024 / 1024",
            "legendFormat": "已使用",
            "refId": "A"
          },
          {
            "expr": "node_memory_MemTotal_bytes / 1024 / 1024 / 1024",
            "legendFormat": "总计",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "decbytes", "label": "内存 (GB)"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 4,
        "title": "磁盘使用率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "(node_filesystem_size_bytes{fstype!=\"rootfs\"} - node_filesystem_avail_bytes{fstype!=\"rootfs\"}) / node_filesystem_size_bytes{fstype!=\"rootfs\"} * 100",
            "legendFormat": "{{mountpoint}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "使用率 (%)", "max": 100, "min": 0},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 5,
        "title": "网络流量 (接收)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])",
            "legendFormat": "{{device}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "Bps", "label": "接收速率"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 6,
        "title": "网络流量 (发送)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
            "legendFormat": "{{device}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "Bps", "label": "发送速率"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 7,
        "title": "磁盘IO (读取)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(node_disk_read_bytes_total[5m])",
            "legendFormat": "{{device}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "Bps", "label": "读取速率"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 8,
        "title": "磁盘IO (写入)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "rate(node_disk_written_bytes_total[5m])",
            "legendFormat": "{{device}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "Bps", "label": "写入速率"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}


