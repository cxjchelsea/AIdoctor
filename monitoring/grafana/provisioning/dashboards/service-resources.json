{
  "dashboard": {
    "title": "服务资源监控",
    "tags": ["services", "resources"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "各服务QPS",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (service)",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "请求/秒"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 2,
        "title": "各服务响应时间 (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "响应时间 (秒)"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 3,
        "title": "Java服务JVM堆内存使用",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\"} / 1024 / 1024 / 1024",
            "legendFormat": "{{service}} - {{instance}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "decbytes", "label": "内存 (GB)"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 4,
        "title": "Java服务进程CPU使用率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total[5m]) * 100",
            "legendFormat": "{{service}} - {{instance}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "CPU使用率 (%)"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 5,
        "title": "Java服务进程内存使用",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "process_resident_memory_bytes / 1024 / 1024 / 1024",
            "legendFormat": "{{service}} - {{instance}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "decbytes", "label": "内存 (GB)"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      },
      {
        "id": 6,
        "title": "各服务错误率",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum(rate(http_request_errors_total[5m])) by (service) / sum(rate(http_requests_total[5m])) by (service) * 100",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "错误率 (%)"},
          {"format": "short"}
        ],
        "xaxis": {"mode": "time", "show": true},
        "legend": {"show": true}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}

