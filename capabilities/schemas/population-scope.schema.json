{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.aidoctor.dev/capabilities/1.0.0/population-scope.schema.json",
  "title":"Population Scope","description":"Technical scope and exclusions awaiting clinical and policy approval.",
  "type":"object","additionalProperties":false,
  "required":["capability_id","package_version","asset_id","schema_version","review_status","adult_age_boundary","supported_chief_complaint_categories","supported_encounter_types","explicit_exclusions","unsupported_requests","escalation_required_categories","non_goals","governance"],
  "properties":{
    "capability_id":{"const":"adult_respiratory_v1"},"package_version":{"$ref":"capability-manifest.schema.json#/$defs/version"},"asset_id":{"$ref":"capability-manifest.schema.json#/$defs/id"},"schema_version":{"const":"1.0.0"},"review_status":{"$ref":"capability-manifest.schema.json#/$defs/reviewStatus"},
    "adult_age_boundary":{"type":"object","additionalProperties":false,"required":["status","minimum_age","maximum_age"],"properties":{"status":{"const":"REQUIRES_CLINICAL_REVIEW"},"minimum_age":{"type":"null"},"maximum_age":{"type":"null"}}},
    "supported_chief_complaint_categories":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"enum":["RESPIRATORY_SYMPTOM_REPORT","RESPIRATORY_DOCUMENT_DISCUSSION","CARE_NAVIGATION_REQUEST"]}},
    "supported_encounter_types":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"enum":["ASYNCHRONOUS_INFORMATION_COLLECTION","CLINICIAN_ASSISTED_REVIEW"]}},
    "explicit_exclusions":{"$ref":"capability-manifest.schema.json#/$defs/nonEmptyStringArray"},"unsupported_requests":{"$ref":"capability-manifest.schema.json#/$defs/nonEmptyStringArray"},"escalation_required_categories":{"$ref":"capability-manifest.schema.json#/$defs/nonEmptyStringArray"},"non_goals":{"$ref":"capability-manifest.schema.json#/$defs/nonEmptyStringArray"},"governance":{"$ref":"capability-manifest.schema.json#/$defs/governance"}
  }
}
