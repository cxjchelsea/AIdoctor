{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.aidoctor.dev/capabilities/1.0.0/knowledge-policy.schema.json",
  "title":"Knowledge Policy","description":"Source governance and domain-isolation structure without approved medical content.",
  "type":"object","additionalProperties":false,
  "required":["capability_id","package_version","asset_id","schema_version","pack_type","review_status","allowed_source_tiers","region_policy_status","population_policy_status","freshness_policy_status","conflict_policy","no_result_policy","approved_source_count","retrieval_eligibility","patient_knowledge_domain","medical_knowledge_domain","mixed_index_allowed","sources","governance"],
  "properties":{
    "capability_id":{"const":"adult_respiratory_v1"},"package_version":{"$ref":"capability-manifest.schema.json#/$defs/version"},"asset_id":{"$ref":"capability-manifest.schema.json#/$defs/id"},"schema_version":{"const":"1.0.0"},"pack_type":{"enum":["KNOWLEDGE_POLICY","SOURCE_MANIFEST"]},"review_status":{"$ref":"capability-manifest.schema.json#/$defs/reviewStatus"},"allowed_source_tiers":{"type":"array","minItems":1,"maxItems":4,"uniqueItems":true,"items":{"enum":["TIER_1","TIER_2","TIER_3","TIER_4"]}},"region_policy_status":{"const":"REQUIRES_CLINICAL_REVIEW"},"population_policy_status":{"const":"REQUIRES_CLINICAL_REVIEW"},"freshness_policy_status":{"const":"REQUIRES_CLINICAL_REVIEW"},"conflict_policy":{"enum":["FAIL_CLOSED_AND_REQUIRE_REVIEW"]},"no_result_policy":{"enum":["RETURN_EXPLICIT_NO_RESULT"]},"approved_source_count":{"type":"integer","minimum":0,"maximum":9007199254740991},"retrieval_eligibility":{"enum":["BLOCKED","ELIGIBLE"]},"patient_knowledge_domain":{"const":"PATIENT_PRIVATE"},"medical_knowledge_domain":{"const":"MEDICAL_APPROVED"},"mixed_index_allowed":{"const":false},"sources":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/source"}},"governance":{"$ref":"capability-manifest.schema.json#/$defs/governance"}
  },
  "$defs":{"source":{"type":"object","additionalProperties":false,"required":["source_id","title","tier","region","population","freshness_status","license_review","clinical_review","withdrawal_status","release_binding","checksum","retrieval_eligibility"],"properties":{"source_id":{"$ref":"capability-manifest.schema.json#/$defs/id"},"title":{"$ref":"capability-manifest.schema.json#/$defs/boundedString"},"tier":{"enum":["TIER_1","TIER_2","TIER_3","TIER_4"]},"region":{"$ref":"capability-manifest.schema.json#/$defs/boundedString"},"population":{"$ref":"capability-manifest.schema.json#/$defs/boundedString"},"freshness_status":{"enum":["CURRENT","REVIEW_DUE","STALE","UNKNOWN"]},"license_review":{"enum":["PENDING","APPROVED","REJECTED"]},"clinical_review":{"enum":["REQUIRES_CLINICAL_REVIEW","APPROVED","REJECTED"]},"withdrawal_status":{"enum":["AVAILABLE","WITHDRAWN"]},"release_binding":{"$ref":"capability-manifest.schema.json#/$defs/id"},"checksum":{"type":"string","pattern":"^[a-f0-9]{64}$","maxLength":64},"retrieval_eligibility":{"enum":["BLOCKED","ELIGIBLE"]}}}}
}
