{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.aidoctor.dev/capabilities/1.0.0/eval-case.schema.json",
  "title":"Synthetic Capability Evaluation Case","description":"Synthetic structural fixture; it is not clinical validation evidence.",
  "type":"object","additionalProperties":false,
  "required":["case_id","suite_type","synthetic","patient_data_classification","input","expected_structural_outcome","required_evidence","expected_enforcement_layer","clinical_review_status","blocked_assertions","notes"],
  "properties":{
    "case_id":{"$ref":"capability-manifest.schema.json#/$defs/id"},"suite_type":{"enum":["SAFETY","EXTRACTION","QUESTION","RAG","E2E"]},"synthetic":{"const":true},"patient_data_classification":{"const":"SYNTHETIC_NON_PATIENT"},"input":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/inputItem"}},"expected_structural_outcome":{"$ref":"capability-manifest.schema.json#/$defs/boundedString"},"required_evidence":{"$ref":"capability-manifest.schema.json#/$defs/nonEmptyStringArray"},"expected_enforcement_layer":{"enum":["SCHEMA_ENFORCED","VALIDATOR_ENFORCED","POLICY_ENFORCED_LATER"]},"clinical_review_status":{"const":"REQUIRES_CLINICAL_REVIEW"},"blocked_assertions":{"$ref":"capability-manifest.schema.json#/$defs/nonEmptyStringArray"},"notes":{"$ref":"capability-manifest.schema.json#/$defs/boundedString"}
  },
  "$defs":{"inputItem":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"$ref":"capability-manifest.schema.json#/$defs/id"},"value":{"$ref":"capability-manifest.schema.json#/$defs/boundedString"}}}}
}
