{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.aidoctor.dev/capabilities/1.0.0/hypothesis-pack.schema.json",
  "title":"Hypothesis Pack","description":"Finite hypothesis candidate structure; it does not authorize diagnosis.",
  "type":"object","additionalProperties":false,
  "required":["capability_id","package_version","asset_id","schema_version","review_status","allowed_categories","hypotheses","free_expansion_allowed","automatic_diagnosis_allowed","runtime_eligibility","governance"],
  "properties":{
    "capability_id":{"const":"adult_respiratory_v1"},"package_version":{"$ref":"capability-manifest.schema.json#/$defs/version"},"asset_id":{"$ref":"capability-manifest.schema.json#/$defs/id"},"schema_version":{"const":"1.0.0"},"review_status":{"$ref":"capability-manifest.schema.json#/$defs/reviewStatus"},"allowed_categories":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"enum":["COMMON","ALTERNATIVE","MUST_NOT_MISS"]}},"hypotheses":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/hypothesis"}},"free_expansion_allowed":{"const":false},"automatic_diagnosis_allowed":{"const":false},"runtime_eligibility":{"enum":["BLOCKED","CLINICAL_REVIEW_ONLY"]},"governance":{"$ref":"capability-manifest.schema.json#/$defs/governance"}
  },
  "$defs":{"hypothesis":{"type":"object","additionalProperties":false,"required":["hypothesis_id","display_name","category","supporting_evidence_refs","opposing_evidence_refs","missing_evidence_refs","applicability","review_status","clinical_source_requirements","prohibited_auto_actions"],"properties":{"hypothesis_id":{"$ref":"capability-manifest.schema.json#/$defs/id"},"display_name":{"$ref":"capability-manifest.schema.json#/$defs/boundedString"},"category":{"enum":["COMMON","ALTERNATIVE","MUST_NOT_MISS"]},"supporting_evidence_refs":{"$ref":"capability-manifest.schema.json#/$defs/stringArray"},"opposing_evidence_refs":{"$ref":"capability-manifest.schema.json#/$defs/stringArray"},"missing_evidence_refs":{"$ref":"capability-manifest.schema.json#/$defs/stringArray"},"applicability":{"$ref":"capability-manifest.schema.json#/$defs/boundedString"},"review_status":{"enum":["REQUIRES_CLINICAL_REVIEW","LEGACY_CANDIDATE","APPROVED"]},"clinical_source_requirements":{"$ref":"capability-manifest.schema.json#/$defs/nonEmptyStringArray"},"prohibited_auto_actions":{"$ref":"capability-manifest.schema.json#/$defs/nonEmptyStringArray"}}}}
}
