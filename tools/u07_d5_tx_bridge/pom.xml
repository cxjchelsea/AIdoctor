   <include>com/aidoctor/diagnosis/runtime/u01/ConsultationRepository.java</include>
   <include>com/aidoctor/diagnosis/runtime/u01/U01StartCommand.java</include>
   <include>com/aidoctor/diagnosis/runtime/u01/U01SemanticDecision.java</include>
   <include>com/aidoctor/diagnosis/runtime/u06/wait/ConsultationWait*.java</include>
  </includes></configuration></plugin></plugins>
 </build>
</project>
